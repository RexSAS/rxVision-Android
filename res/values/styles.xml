<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default; MainActivity applies the chosen theme (Theme.java) and draws the grain. -->
    <style name="Theme.Liquid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/ember</item>
        <!-- No icon splash: the launch is the ink-drop intro (Liquid.intro). -->
        <item name="android:windowSplashScreenBackground">@color/night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <color name="night">#FF0F0F10</color>
    <color name="ember">#FFFF4D00</color>
</resources>
