<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.andrea.rxvision">

    <!-- A launcher lists every app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Flick down on Home pulls the notifications down. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- The phone's wallpaper (home and lock) is kept a plain fill of the theme's background. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Liquid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
